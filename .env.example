# Backend API base URL (must include /api)
VITE_API_URL=https://mvec-backend-production.up.railway.app/api

# Socket.IO server URL (real-time messaging/notifications). Defaults to the
# same host as VITE_API_URL with /api stripped, so this is only needed if
# your Socket.IO server runs on a different host/port than the REST API.
VITE_SOCKET_URL=https://mvec-backend-production.up.railway.app
